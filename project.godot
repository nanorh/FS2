; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.

config_version=5

[application]

config/name="FS2 Falling Sand"
run/main_scene="res://src/main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")

[display]

; The grid fills the whole viewport; the control panel floats over the
; bottom of it, so no height is reserved for the panel.
; Stretch is disabled so the viewport tracks the window pixel-for-pixel and
; the simulation grid can grow with it.
window/size/viewport_width=1280
window/size/viewport_height=820
window/size/resizable=true
window/stretch/mode="disabled"

[rendering]

renderer/rendering_method="forward_plus"
textures/canvas_textures/default_texture_filter=0
